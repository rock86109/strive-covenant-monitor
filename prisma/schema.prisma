generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  emailVerified    DateTime?
  name             String?
  createdAt        DateTime          @default(now())
  accounts         Account[]
  covenantSessions CovenantSession[]
  sessions         Session[]
  telemetryEvents  TelemetryEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CovenantSession {
  id                String           @id @default(cuid())
  userId            String
  documentType      String?
  borrowerName      String?
  borrowerEmail     String?
  income            Float?
  loanAmount        Float     @default(0)
  scanQuality       String?
  totalDebt         Float?
  totalEquity       Float?
  debtToEquityRatio Float?
  decision          String?
  decisionNotes     String?
  currentStep       Int              @default(1)
  status            String           @default("in_progress")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  completedAt       DateTime?
  user              User             @relation(fields: [userId], references: [id])
  telemetryEvents   TelemetryEvent[]
}

model TelemetryEvent {
  id                String           @id @default(cuid())
  userId            String
  covenantSessionId String?
  eventType         String
  step              Int?
  fieldName         String?
  oldValue          String?
  newValue          String?
  timeOnStepMs      Int?
  fieldChangeCount  Int?
  metadata          Json?
  createdAt         DateTime         @default(now())
  covenantSession   CovenantSession? @relation(fields: [covenantSessionId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
}
